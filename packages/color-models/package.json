{
  "name": "@omi-io/color-models",
  "scopeCommitName": "@:models",
  "version": "0.2.1",
  "description": "Nominal TypeScript brands for semantic color tuples (e.g. linear vs encoded RGB, XYZ, Lab) plus aliases for extended spaces like LCh and Oklab.",
  "keywords": [
    "color",
    "branded-types",
    "nominal-types",
    "color-space",
    "rgb",
    "xyz",
    "lab",
    "oklab",
    "lch",
    "linear-light",
    "colorimetry"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-omi-io/color.git",
    "directory": "packages/color-models"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "scripts": {
    "clean": "omi-io-pkg clean",
    "build": "yarn clean && omi-io-pkg build && tsc && omi-io-pkg alias",
    "test": "jest",
    "lint": "eslint ./src",
    "tsc-check": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@omi-io/color-core": "^0.1.0"
  },
  "devDependencies": {
    "@omi-io/pkg-scripts": "v2.5.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.30",
    "eslint": "^8.57.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.0.5",
    "typescript": "~5.4.3"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ]
}
