{
  "name": "@omi-io/color-core",
  "scopeCommitName": "@:core",
  "version": "0.0.1",
  "description": "Foundational colorimetry primitives—tuples, CIE constants, 3x3 matrix/vector math, channel normalization—without conversion logic.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-omi-io/color.git",
    "directory": "packages/color-core"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "scripts": {
    "clean": "omi-io-pkg clean",
    "build": "yarn clean && omi-io-pkg build && tsc && omi-io-pkg alias",
    "test": "jest",
    "lint": "eslint ./src",
    "tsc-check": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@omi-io/auxiliaries": "^1.1.0"
  },
  "devDependencies": {
    "@omi-io/pkg-scripts": "v2.5.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.30",
    "eslint": "^8.57.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.0.5",
    "typescript": "~5.4.3"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json",
    "./types": {
      "types": "./dist/types/types/index.d.ts",
      "require": "./dist/cjs/types/types.cjs",
      "default": "./dist/esm/types/types.js"
    },
    "./math": {
      "types": "./dist/types/math/index.d.ts",
      "require": "./dist/cjs/math/index.cjs",
      "default": "./dist/esm/math/index.js"
    },
    "./normalization": {
      "types": "./dist/types/normalization/index.d.ts",
      "require": "./dist/cjs/normalization/index.cjs",
      "default": "./dist/esm/normalization/index.js"
    },
    "./constants": {
      "types": "./dist/types/constants/index.d.ts",
      "require": "./dist/cjs/constants/index.cjs",
      "default": "./dist/esm/constants/index.js"
    }
  }
}
